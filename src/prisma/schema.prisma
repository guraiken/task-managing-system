// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  email String @unique
  nome  String
  senha String
  role  Role   @default(USER)

  tokens Token[]

  usuarioEmProjetos UsuarioEmProjeto[]

  tarefasComoDono        Tarefa[]          @relation("DonoTarefa")
  tarefasComoResponsavel Tarefa[]          @relation("ResponsavelTarefa")
  usuarioEmTarefas       UsuarioEmTarefa[]

  @@map("usuario")
}
enum Role {
  USER
  ADMIN
}
enum TypeToken {
  ACCESS
  REFRESH
}


model Token {
  id        Int       @id @default(autoincrement())
  token     String    @db.VarChar(255)
  type      TypeToken @default(ACCESS)
  revoked   Boolean   @default(false)
  expiresAt DateTime
  usuarioId Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("token")
}


model Projeto {
  id                Int    @id @default(autoincrement())
  nome              String
  area_conhecimento String

  membros UsuarioEmProjeto[]
  tarefas Tarefa[]

  @@map("projeto")
}


model UsuarioEmProjeto {
  projetoId Int
  usuarioId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id])
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@id([projetoId, usuarioId])
}


model Tarefa {
  id Int @id @default(autoincrement())

  projeto_id Int
  projeto    Projeto @relation(fields: [projeto_id], references: [id])

  titulo_trf  String
  descr       String
  dono_id     Int
  dono        Usuario           @relation("DonoTarefa", fields: [dono_id], references: [id])
  resp_id     Int
  responsavel Usuario           @relation("ResponsavelTarefa", fields: [resp_id], references: [id])
  data_i      DateTime
  data_f      DateTime
  prioridade  Prioridade
  status      Status
  usuarios    UsuarioEmTarefa[]
}
enum Prioridade {
  Baixa
  Media
  Alta
}
enum Status {
  Pausada
  Andamento
  Concluida
  Reaberta
}


model UsuarioEmTarefa {
  tarefaId  Int
  usuarioId Int

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([tarefaId, usuarioId])
}
