// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id Int @id @default(autoincrement())

  nome         String
  nivel_acesso NivelAcesso

  tarefas_dono Tarefa[]  @relation("DonoTarefa")
  tarefas_resp Tarefa[]  @relation("ResponsavelTarefa")
  tarefas      UsuarioEmTarefa[]
  projetos     Projeto[]
}

enum NivelAcesso {
  A
  B
  C
  D
  E
}

model Projeto {
  id Int @id @default(autoincrement())

  dono_id Int
  dono    Usuario @relation(fields: [dono_id], references: [id])

  titulo_prjt String
  area        String @default("Desconhecida")
  descr       String @default("Pendente")

  tarefas Tarefa[]
}

model Tarefa {
  id Int @id @default(autoincrement())

  projeto_id Int
  projeto    Projeto @relation(fields: [projeto_id], references: [id])

  titulo_trf   String
  descr        String
  dono_id      Int
  dono         Usuario     @relation("DonoTarefa", fields: [dono_id], references: [id])
  resp_id      Int
  responsavel  Usuario     @relation("ResponsavelTarefa", fields: [resp_id], references: [id])
  nivel_acesso NivelAcesso
  data_i       DateTime
  data_v       DateTime
  data_f       DateTime
  prioridade   Prioridade
  status       Status
  usuarios     UsuarioEmTarefa[]
}

model UsuarioEmTarefa {
  tarefaId  Int
  usuarioId Int

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([tarefaId, usuarioId])
}

enum Prioridade {
  Baixa
  Media
  Alta
}

enum Status {
  Pausada
  Andamento
  Concluida
  Reaberta
} 
